# ---- Runtime artifacts (generated on every start, not worth versioning) ----
.server.log
.server.pid
nohup.out
*.log

# ---- Credentials and account data (sensitive, never committed) ----
data/

# ---- Local configuration (machine-specific; the default file is <root>/doclight.toml) ----
# Keep this ignored so a locally placed config cannot silently change test results
# (see src/tests/config.test.ts and the isolation in http-footer / space-api tests).
doclight.toml

# ---- Dependencies and editors ----
node_modules/
dist/
public/app.js
.DS_Store

# ---- Local screenshot verification (headless browser artifacts, includes profile cache) ----
.verify/

# ---- Nix build artifacts (symlinks created by nix build) ----
result
result-*
